          "content": {
            "size": -1,
            "mimeType": "text/javascript",
            "text": "import apiClient, { handleApiError } from \"/api/config.ts\";\nclass AuthService {\n  /**\n   * Login user with email and password\n   * POST /api/accounts/login/\n   */\n  async login(credentials) {\n    try {\n      const response = await apiClient.post(\n        \"/api/accounts/login/\",\n        credentials\n      );\n      const { access, refresh, user } = response.data;\n      localStorage.setItem(\"token\", access);\n      localStorage.setItem(\"refresh_token\", refresh);\n      localStorage.setItem(\"user_data\", JSON.stringify({ ...user, token: access }));\n      return { ...user, token: access };\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Register new user\n   * POST /api/accounts/register/\n   */\n  async register(data) {\n    try {\n      const response = await apiClient.post(\n        \"/api/accounts/register/\",\n        data,\n        { timeout: 6e4 }\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Refresh access token\n   * POST /api/accounts/refresh/\n   */\n  async refreshToken(refreshToken) {\n    try {\n      const response = await apiClient.post(\n        \"/api/accounts/refresh/\",\n        { refresh: refreshToken }\n      );\n      const { access } = response.data;\n      localStorage.setItem(\"token\", access);\n      return access;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Get current user profile\n   * GET /api/accounts/me/\n   */\n  async getCurrentUser() {\n    try {\n      const response = await apiClient.get(\"/api/accounts/me/\");\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Update user profile\n   * PATCH /api/accounts/profile/\n   */\n  async updateProfile(data) {\n    try {\n      const formData = new FormData();\n      Object.entries(data).forEach(([key, value]) => {\n        if (value !== void 0 && value !== null) {\n          if (key === \"avatar\" && typeof value === \"string\" && value.startsWith(\"blob:\")) {\n            return;\n          }\n          formData.append(key, value);\n        }\n      });\n      const response = await apiClient.patch(\n        \"/api/accounts/profile/\",\n        data.avatar ? formData : data,\n        data.avatar ? {\n          headers: { \"Content-Type\": \"multipart/form-data\" }\n        } : void 0\n      );\n      const currentUser = JSON.parse(localStorage.getItem(\"user_data\") || \"{}\");\n      const updatedUser = { ...currentUser, ...response.data };\n      localStorage.setItem(\"user_data\", JSON.stringify(updatedUser));\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Verify email with token\n   * POST /api/accounts/verify-email/\n   */\n  async verifyEmail(token) {\n    try {\n      const response = await apiClient.post(\n        \"/api/accounts/verify-email/\",\n        { token }\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Resend verification email\n   * POST /api/accounts/resend-verification/\n   */\n  async resendVerificationEmail(email) {\n    try {\n      const response = await apiClient.post(\n        \"/api/accounts/resend-verification/\",\n        { email },\n        { timeout: 6e4 }\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Request password reset\n   * POST /api/accounts/forgot-password/\n   */\n  async forgotPassword(email) {\n    try {\n      const response = await apiClient.post(\n        \"/api/accounts/forgot-password/\",\n        { email },\n        { timeout: 6e4 }\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Reset password with OTP\n   * POST /api/accounts/reset-password/\n   */\n  async resetPassword(otp, newPassword, confirmPassword) {\n    try {\n      const response = await apiClient.post(\n        \"/api/accounts/reset-password/\",\n        { otp, new_password: newPassword, confirm_password: confirmPassword },\n        { timeout: 6e4 }\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Logout user (clear local storage)\n   */\n  logout() {\n    localStorage.removeItem(\"token\");\n    localStorage.removeItem(\"refresh_token\");\n    localStorage.removeItem(\"user_data\");\n  }\n  /**\n   * Check if user is authenticated\n   */\n  isAuthenticated() {\n    return !!localStorage.getItem(\"token\");\n  }\n  /**\n   * Get stored user data\n   */\n  getStoredUser() {\n    const userData = localStorage.getItem(\"user_data\");\n    return userData ? JSON.parse(userData) : null;\n  }\n}\nexport default new AuthService();\n\n//# sourceMappingURL=data:application/json;base64,"
