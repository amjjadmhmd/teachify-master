            "text": "export const STATIC_COURSES_STORAGE_KEY = \"geotop_static_courses_v1\";\nconst isBrowser = () => typeof window !== \"undefined\";\nconst sanitizeCourses = (raw) => {\n  if (!Array.isArray(raw)) return [];\n  return raw.filter(\n    (course) => course && typeof course === \"object\" && typeof course.id === \"number\" && typeof course.title === \"string\"\n  ).map((course) => ({\n    ...course,\n    is_enrolled: true,\n    lessons: Array.isArray(course.lessons) ? course.lessons : [],\n    resources: Array.isArray(course.resources) ? course.resources : [],\n    static_source: course.static_source || \"instructor\"\n  }));\n};\nexport const getStaticCourses = () => {\n  if (!isBrowser()) return [];\n  try {\n    const raw = window.localStorage.getItem(STATIC_COURSES_STORAGE_KEY);\n    if (!raw) return [];\n    return sanitizeCourses(JSON.parse(raw));\n  } catch (error) {\n    console.error(\"Failed to parse static courses:\", error);\n    return [];\n  }\n};\nexport const saveStaticCourses = (courses) => {\n  if (!isBrowser()) return;\n  try {\n    window.localStorage.setItem(\n      STATIC_COURSES_STORAGE_KEY,\n      JSON.stringify(sanitizeCourses(courses))\n    );\n  } catch (error) {\n    console.error(\"Failed to save static courses:\", error);\n  }\n};\nexport const upsertStaticCourse = (course) => {\n  const existing = getStaticCourses();\n  const next = [\n    course,\n    ...existing.filter((storedCourse) => storedCourse.id !== course.id)\n  ];\n  saveStaticCourses(next);\n  return next;\n};\nexport const nextStaticCourseId = () => Date.now() + Math.floor(Math.random() * 1e3);\nexport const isStaticCourse = (course) => {\n  if (!course) return false;\n  return Boolean(\n    course.static_source || typeof course.id === \"number\" && course.id >= 9e5\n  );\n};\n\n//# sourceMappingURL=data:application/json;base64,"
