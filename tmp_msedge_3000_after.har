          "content": {
            "size": -1,
            "mimeType": "text/css",
            "text": ":root {\n  --neon-card-border: #00e5ff;\n  --neon-card-border-soft: rgba(0, 229, 255, 0.82);\n  --portal-card-bg-light: #eaf4ff;\n  --portal-card-bg-light-soft: rgba(234, 244, 255, 0.82);\n  --neon-card-glow:\n    0 0 0 1px rgba(0, 229, 255, 0.3),\n    0 0 34px -18px rgba(0, 229, 255, 0.95);\n}\n\n/* Match controls borders with cards in student/instructor portals */\n.portal-role-student :is(button, a, input, select, textarea)[class*=\"border\"],\n.portal-role-instructor :is(button, a, input, select, textarea)[class*=\"border\"] {\n  border-color: var(--neon-card-border-soft) !important;\n}\n\n.portal-role-student :is(button, a, [role=\"button\"]):not([class*=\"border\"]),\n.portal-role-instructor :is(button, a, [role=\"button\"]):not([class*=\"border\"]) {\n  border: 1px solid var(--neon-card-border-soft) !important;\n}\n\n.portal-role-student :is(button, a, input, select, textarea, [role=\"button\"]):focus-visible,\n.portal-role-student :is(button, a, input, select, textarea, [role=\"button\"]):hover,\n.portal-role-instructor :is(button, a, input, select, textarea, [role=\"button\"]):focus-visible,\n.portal-role-instructor :is(button, a, input, select, textarea, [role=\"button\"]):hover {\n  border-color: var(--neon-card-border) !important;\n}\n\n.portal-role-student .ui-card,\n.portal-role-instructor .ui-card {\n  border-color: var(--neon-card-border) !important;\n  box-shadow: var(--neon-card-glow) !important;\n}\n\n.portal-role-student :is(div, section, article, aside, li)[class*=\"rounded-xl\"][class*=\"border\"],\n.portal-role-student :is(div, section, article, aside, li)[class*=\"rounded-2xl\"][class*=\"border\"],\n.portal-role-student :is(div, section, article, aside, li)[class*=\"rounded-3xl\"][class*=\"border\"],\n.portal-role-instructor :is(div, section, article, aside, li)[class*=\"rounded-xl\"][class*=\"border\"],\n.portal-role-instructor :is(div, section, article, aside, li)[class*=\"rounded-2xl\"][class*=\"border\"],\n.portal-role-instructor :is(div, section, article, aside, li)[class*=\"rounded-3xl\"][class*=\"border\"] {\n  border-color: var(--neon-card-border-soft) !important;\n}\n\n.portal-role-student .ui-card:hover,\n.portal-role-instructor .ui-card:hover {\n  border-color: var(--neon-card-border) !important;\n  box-shadow:\n    0 0 0 1px rgba(0, 229, 255, 0.4),\n    0 0 44px -16px rgba(0, 229, 255, 0.95) !important;\n}\n\n/* Light mode only: make student/instructor cards clearly visible with soft blue backgrounds */\nhtml:not(.dark) .portal-role-student main .ui-card,\nhtml:not(.dark) .portal-role-instructor main .ui-card {\n  background-color: var(--portal-card-bg-light) !important;\n}\n\nhtml:not(.dark) .portal-role-student main :is(div, section, article, aside, li)[class*=\"rounded-xl\"][class*=\"border\"],\nhtml:not(.dark) .portal-role-student main :is(div, section, article, aside, li)[class*=\"rounded-2xl\"][class*=\"border\"],\nhtml:not(.dark) .portal-role-student main :is(div, section, article, aside, li)[class*=\"rounded-3xl\"][class*=\"border\"],\nhtml:not(.dark) .portal-role-instructor main :is(div, section, article, aside, li)[class*=\"rounded-xl\"][class*=\"border\"],\nhtml:not(.dark) .portal-role-instructor main :is(div, section, article, aside, li)[class*=\"rounded-2xl\"][class*=\"border\"],\nhtml:not(.dark) .portal-role-instructor main :is(div, section, article, aside, li)[class*=\"rounded-3xl\"][class*=\"border\"] {\n  background-color: var(--portal-card-bg-light-soft) !important;\n}\n\n/* Sidebar: keep wheel scrolling, hide the white scrollbar rail/thumb */\n.sidebar-scroll {\n  overflow-y: auto;\n  overflow-x: hidden;\n  scrollbar-width: none; /* Firefox */\n  -ms-overflow-style: none; /* IE/Edge legacy */\n}\n\n.sidebar-scroll::-webkit-scrollbar {\n  width: 0;\n  height: 0;\n}\n\n/* Generic helper: allow scrolling but hide scrollbar visuals */\n.hide-scrollbar {\n  scrollbar-width: none; /* Firefox */\n  -ms-overflow-style: none; /* IE/Edge legacy */\n}\n\n.hide-scrollbar::-webkit-scrollbar {\n  width: 0;\n  height: 0;\n  display: none;\n}\n"
          },
          "headersSize": -1,
          "bodySize": -1,
          "redirectURL": ""
