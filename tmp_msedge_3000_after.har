          ],
          "content": {
            "size": -1,
            "mimeType": "text/javascript",
            "text": "import authService from \"/api/services/authService.ts\";\nimport coursesService from \"/api/services/coursesService.ts\";\nimport paymentService from \"/api/services/paymentService.ts\";\nimport apiClient, { handleApiError } from \"/api/config.ts\";\nclass ExamsService {\n  /**\n    * Get all exams\n    * GET /api/exams/\n    */\n  async listExams() {\n    try {\n      const response = await apiClient.get(\"/api/exams/\");\n      if (Array.isArray(response.data)) {\n        return response.data;\n      }\n      return response.data.results || [];\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Get exam details with questions\n   * GET /api/exams/{id}/\n   */\n  async getExam(id) {\n    try {\n      const response = await apiClient.get(`/api/exams/${id}/`);\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Get questions for an exam\n   * GET /api/questions/?exam={id}\n   */\n  async getQuestions(examId) {\n    try {\n      const response = await apiClient.get(\n        \"/api/questions/\",\n        { params: { exam: examId } }\n      );\n      return response.data.results;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Submit exam answers\n   * POST /api/exams/{id}/submit/\n   */\n  async submitExam(examId, data) {\n    try {\n      const response = await apiClient.post(\n        `/api/exams/${examId}/submit/`,\n        data\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n    * Get exam attempts\n    * GET /api/attempts/\n    */\n  async listAttempts() {\n    try {\n      const response = await apiClient.get(\n        \"/api/attempts/\"\n      );\n      if (Array.isArray(response.data)) {\n        return response.data;\n      }\n      return response.data.results || [];\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Get certificates\n   * GET /api/certificates/\n   */\n  async listCertificates() {\n    try {\n      const response = await apiClient.get(\"/api/certificates/\");\n      console.log(\"Raw API response:\", response);\n      if (Array.isArray(response.data)) {\n        console.log(\"Response is array:\", response.data);\n        return response.data;\n      }\n      if (response.data?.results) {\n        console.log(\"Response has results:\", response.data.results);\n        return response.data.results;\n      }\n      console.log(\"No data found, returning empty array\");\n      return [];\n    } catch (error) {\n      console.error(\"Error in listCertificates:\", error);\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Get certificates (alias for listCertificates)\n   */\n  async getCertificates() {\n    return this.listCertificates();\n  }\n  /**\n   * Create exam (Instructor only)\n   * POST /api/exams/\n   */\n  async createExam(data) {\n    try {\n      const response = await apiClient.post(\"/api/exams/\", data);\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Create question (Instructor only)\n   * POST /api/questions/\n   */\n  async createQuestion(data) {\n    try {\n      const response = await apiClient.post(\"/api/questions/\", data);\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Get exam submissions (Instructor only)\n   * GET /api/exams/{id}/submissions/\n   */\n  async getExamSubmissions(examId) {\n    try {\n      const response = await apiClient.get(\n        `/api/exams/${examId}/submissions/`\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Delete exam (Instructor only)\n   * DELETE /api/exams/{id}/\n   */\n  async deleteExam(examId) {\n    try {\n      await apiClient.delete(`/api/exams/${examId}/`);\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n}\nclass NotificationsService {\n  /**\n   * Get user's notifications\n   * GET /api/notifications/\n   */\n  async listNotifications(userId) {\n    try {\n      const response = await apiClient.get(\n        \"/api/notifications/\"\n      );\n      if (Array.isArray(response.data)) {\n        return response.data;\n      }\n      return response.data.results || [];\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Create notification (Instructor only)\n   * POST /api/notifications/\n   */\n  async createNotification(data) {\n    try {\n      const response = await apiClient.post(\n        \"/api/notifications/\",\n        data\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Send message to student (Instructor only)\n   * POST /api/notifications/\n   */\n  async sendMessage(studentId, message) {\n    try {\n      const response = await apiClient.post(\n        \"/api/notifications/\",\n        {\n          user: studentId,\n          title: \"Message from Instructor\",\n          message,\n          type: \"info\"\n        }\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n    * Request certificate\n    * POST /api/certificate-requests/\n    */\n  async requestCertificate(courseTitle, user, instructorId) {\n    try {\n      const response = await apiClient.post(\n        \"/api/certificate-requests/\",\n        {\n          student: user.id,\n          instructor: instructorId,\n          course_title: courseTitle\n        }\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Mark notification as read\n   * PATCH /api/notifications/{id}/\n   */\n  async markAsRead(id) {\n    try {\n      const response = await apiClient.patch(\n        `/api/notifications/${id}/`,\n        { is_read: true }\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Mark all notifications as read\n   * POST /api/notifications/mark_all_as_read/\n   */\n  async markAllAsRead() {\n    try {\n      await apiClient.post(\"/api/notifications/mark_all_as_read/\");\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n}\nclass PublicService {\n  /**\n   * Get platform statistics\n   * GET /public/stats/\n   */\n  async getStats() {\n    try {\n      const response = await apiClient.get(\"/public/stats/\");\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n  /**\n   * Get public instructors list\n   * GET /public/instructors/\n   */\n  async getInstructors() {\n    try {\n      const response = await apiClient.get(\n        \"/public/instructors/\"\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n}\nclass InstructorService {\n  /**\n   * Send certificate to student\n   * POST /api/certificates/\n   */\n  async sendCertificate(studentId, courseTitle, imageFile) {\n    try {\n      const formData = new FormData();\n      formData.append(\"student\", studentId.toString());\n      formData.append(\"course_title\", courseTitle);\n      formData.append(\"image\", imageFile);\n      const response = await apiClient.post(\n        \"/api/certificates/\",\n        formData,\n        {\n          headers: {\n            \"Content-Type\": \"multipart/form-data\"\n          }\n        }\n      );\n      return response.data;\n    } catch (error) {\n      throw new Error(handleApiError(error));\n    }\n  }\n}\nconst examsService = new ExamsService();\nconst notificationsService = new NotificationsService();\nconst publicService = new PublicService();\nconst instructorService = new InstructorService();\nexport {\n  authService,\n  coursesService,\n  paymentService,\n  examsService,\n  notificationsService,\n  publicService,\n  instructorService\n};\nexport default {\n  auth: authService,\n  courses: coursesService,\n  payment: paymentService,\n  exams: examsService,\n  notifications: notificationsService,\n  public: publicService,\n  instructor: instructorService\n};\n\n//# sourceMappingURL=data:application/json;base64,"
