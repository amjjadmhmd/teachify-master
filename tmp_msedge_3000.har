            "text": "<!DOCTYPE html>\r\n<html lang=\"en\"> <!-- Changed from class=\"dark\" to standard light mode -->\r\n\r\n<head>\n  <script type=\"module\">import { injectIntoGlobalHook } from \"/@react-refresh\";\ninjectIntoGlobalHook(window);\nwindow.$RefreshReg$ = () => {};\nwindow.$RefreshSig$ = () => (type) => type;</script>\n\n  <script type=\"module\" src=\"/@vite/client\"></script>\n\r\n  <meta charset=\"UTF-8\" />\r\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/vite.svg\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n  <title>Geo Top - Premium Learning Workspace</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\r\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n  <link\r\n    href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Cairo:wght@400;500;600;700&display=swap\"\r\n    rel=\"stylesheet\">\r\n  <script>\n    tailwind.config = {\n      darkMode: 'class',\n      theme: {\n        extend: {\n          fontFamily: {\r\n            sans: ['\"Inter\"', '\"Cairo\"', 'sans-serif'],\r\n            display: ['\"Inter\"', '\"Cairo\"', 'sans-serif'],\r\n          },\r\n          colors: {\n            'eden-bg': '#FFFFFF',\n            'eden-card': '#F5F7FA',\n            'eden-accent': '#007BFF',\n            'eden-accent-hover': '#1B5EBD',\n            't-primary': '#007BFF',\n            't-border': 'rgba(0, 0, 0, 0.05)',\n            primary: '#007BFF',\n            dark: '#FFFFFF',\n          },\n          boxShadow: {\n            'glow': '0 0 20px -5px rgba(0, 123, 255, 0.3)',\n            'soft-lift': '0 10px 30px -10px rgba(0, 0, 0, 0.1)',\n          }\n        }\n      }\n    }\r\n  </script>\r\n  <style>\n    :root {\n      --dot-color: rgba(255, 255, 255, 0.03);\n      --ui-bg: #ffffff;\n      --ui-surface: #ffffff;\n      --ui-surface-soft: #f8fafc;\n      --ui-border: #e2e8f0;\n      --ui-text-primary: #0f172a;\n      --ui-text-secondary: #475569;\n      --ui-text-muted: #64748b;\n      --ui-btn-hover: #1b5ebd;\n      --hero-globe-opacity: 0.34;\n      --hero-logo-opacity: 0.74;\n      --hero-ring-opacity: 0.36;\n      --hero-shadow-color: rgba(0, 123, 255, 0.23);\n      --hero-star-opacity: 0.14;\n      --footer-logo-opacity: 0.36;\n      --footer-ring-opacity: 0.26;\n    }\n\n    .dark {\n      --ui-bg: #000000;\n      --ui-surface: #050505;\n      --ui-surface-soft: #0b0b0b;\n      --ui-border: #1f2937;\n      --ui-text-primary: #f8fafc;\n      --ui-text-secondary: #cbd5e1;\n      --ui-text-muted: #94a3b8;\n      --hero-globe-opacity: 0.56;\n      --hero-logo-opacity: 0.88;\n      --hero-ring-opacity: 0.55;\n      --hero-shadow-color: rgba(0, 123, 255, 0.45);\n      --hero-star-opacity: 0.22;\n      --footer-logo-opacity: 0.48;\n      --footer-ring-opacity: 0.34;\n    }\n\n    body {\n      background-color: var(--ui-bg);\n      color: var(--ui-text-primary);\n      overflow-x: hidden;\n    }\n\n    html,\n    body,\n    #root {\n      overflow-x: hidden;\n      scrollbar-width: none;\n      -ms-overflow-style: none;\n    }\n\n    html::-webkit-scrollbar,\n    body::-webkit-scrollbar,\n    #root::-webkit-scrollbar {\n      width: 0;\n      height: 0;\n      display: none;\n    }\n\n    .dark body {\n      background-color: var(--ui-bg);\n      color: var(--ui-text-primary);\n    }\n\n    .dark .bg-eden-bg {\n      background-color: #000000 !important;\n    }\n\n    .dark .bg-eden-card {\n      background-color: #0a0a0a !important;\n    }\n\n    .dark .bg-white {\n      background-color: var(--ui-surface) !important;\n    }\n\n    .dark .bg-white\\/95 {\n      background-color: rgba(0, 0, 0, 0.95) !important;\n    }\n\n    .dark .bg-white\\/90 {\n      background-color: rgba(0, 0, 0, 0.9) !important;\n    }\n\n    .dark .bg-white\\/80 {\n      background-color: rgba(0, 0, 0, 0.8) !important;\n    }\n\n    .dark .bg-slate-50 {\n      background-color: var(--ui-surface-soft) !important;\n    }\n\n    .dark .bg-slate-100 {\n      background-color: #101010 !important;\n    }\n\n    .dark .bg-slate-200 {\n      background-color: #161616 !important;\n    }\n\n    .dark .border-slate-100,\n    .dark .border-slate-200,\n    .dark .border-slate-300 {\n      border-color: var(--ui-border) !important;\n    }\n\n    .dark .text-slate-900,\n    .dark .text-slate-800 {\n      color: var(--ui-text-primary) !important;\n    }\n\n    .dark .text-slate-700,\n    .dark .text-slate-600 {\n      color: var(--ui-text-secondary) !important;\n    }\n\n    .dark .text-slate-500,\n    .dark .text-slate-400 {\n      color: var(--ui-text-muted) !important;\n    }\n\n    .dark .placeholder\\:text-slate-400::placeholder {\n      color: var(--ui-text-muted) !important;\n    }\n\n    button:not(:disabled) {\n      transition: filter 0.2s ease, box-shadow 0.2s ease;\n    }\n\n    button:not(:disabled):hover {\n      filter: brightness(1.03);\n      box-shadow: 0 10px 24px -16px rgba(0, 123, 255, 0.55);\n    }\n\n    button:not(:disabled):active {\n      filter: brightness(0.98);\n    }\n\n    .bg-eden-dots {\n      background-image: radial-gradient(#007BFF 1px, transparent 1px);\n      opacity: 0.1;\n      background-size: 32px 32px;\n    }\n\n    .bg-hero-aura {\n      background: radial-gradient(circle at 50% -20%, rgba(0, 123, 255, 0.1), transparent 70%);\n    }\n\n    .paper-grain {\n      filter: url(#noiseFilter);\n      opacity: 0.02;\n      pointer-events: none;\n    }\n\n    .bg-obsidian-glow {\n      background: radial-gradient(circle at center, rgba(0, 123, 255, 0.05) 0%, transparent 80%);\n      pointer-events: none;\n    }\n\n    .no-select {\n      user-select: none;\n    }\n\n    .rtl {\n      direction: rtl;\n    }\n\n    .hero-ambient-scene {\n      position: absolute;\n      inset: 0;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      pointer-events: none;\n      overflow: hidden;\n      perspective: 1400px;\n      isolation: isolate;\n    }\n\n    .hero-ambient-stars {\n      position: absolute;\n      inset: -20%;\n      opacity: var(--hero-star-opacity);\n      background-image:\n        radial-gradient(circle at 20% 30%, rgba(0, 123, 255, 0.8) 1px, transparent 1.8px),\n        radial-gradient(circle at 74% 58%, rgba(0, 123, 255, 0.8) 1px, transparent 1.6px),\n        radial-gradient(circle at 52% 78%, rgba(15, 23, 42, 0.8) 0.9px, transparent 1.5px);\n      background-size: 210px 210px, 260px 260px, 180px 180px;\n      animation: heroStarDrift 26s linear infinite;\n    }\n\n    .hero-globe-shell {\n      position: relative;\n      width: min(72vw, 760px);\n      aspect-ratio: 1;\n      border-radius: 9999px;\n      transform-style: preserve-3d;\n      opacity: var(--hero-globe-opacity);\n      animation: heroGlobeFloat 13s ease-in-out infinite;\n      box-shadow:\n        inset -30px -24px 90px rgba(2, 6, 23, 0.55),\n        inset 26px 14px 80px rgba(147, 197, 253, 0.18),\n        0 38px 110px -60px var(--hero-shadow-color);\n    }\n\n    .hero-globe-map {\n      position: absolute;\n      inset: 0;\n      border-radius: inherit;\n      background:\n        radial-gradient(circle at 28% 24%, rgba(191, 219, 254, 0.36), transparent 36%),\n        radial-gradient(circle at 60% 66%, rgba(59, 130, 246, 0.3), transparent 52%),\n        url(\"https://images.unsplash.com/photo-1614730321146-b6fa6a46bcb4?auto=format&fit=crop&w=1600&q=80\")\n          center / 155% auto no-repeat;\n      filter: saturate(1.2) contrast(1.08) brightness(0.86);\n      animation: heroGlobeSpin 32s linear infinite;\n    }\n\n    .hero-globe-veil {\n      position: absolute;\n      inset: 0;\n      border-radius: inherit;\n      background:\n        radial-gradient(circle at 30% 28%, rgba(255, 255, 255, 0.2), transparent 38%),\n        radial-gradient(circle at 70% 78%, rgba(2, 132, 199, 0.18), transparent 46%),\n        linear-gradient(130deg, rgba(2, 6, 23, 0.2), transparent 40%, rgba(2, 6, 23, 0.28));\n      mix-blend-mode: screen;\n      animation: heroVeilPulse 8s ease-in-out infinite;\n    }\n\n    .hero-globe-ring {\n      position: absolute;\n      left: 50%;\n      top: 50%;\n      border: 1px solid rgba(0, 123, 255, var(--hero-ring-opacity));\n      border-radius: 9999px;\n      transform-origin: center;\n      filter: drop-shadow(0 0 14px rgba(0, 123, 255, 0.24));\n    }\n\n    .hero-globe-ring--outer {\n      width: 116%;\n      height: 116%;\n      transform: translate(-50%, -50%) rotateX(72deg) rotateZ(0deg);\n      animation: heroRingSpinA 16s linear infinite;\n    }\n\n    .hero-globe-ring--inner {\n      width: 96%;\n      height: 96%;\n      transform: translate(-50%, -50%) rotateY(74deg) rotateX(9deg) rotateZ(0deg);\n      animation: heroRingSpinB 18s linear infinite reverse;\n      opacity: 0.8;\n    }\n\n    .hero-logo-core {\n      position: absolute;\n      left: 50%;\n      top: 50%;\n      width: 36%;\n      aspect-ratio: 1;\n      transform: translate3d(-50%, -50%, 80px);\n      transform-style: preserve-3d;\n      display: grid;\n      place-items: center;\n      border-radius: 9999px;\n      backdrop-filter: blur(1.5px);\n      animation: heroLogoOrbit 9s ease-in-out infinite;\n    }\n\n    .hero-logo-core-img {\n      width: 100%;\n      height: 100%;\n      object-fit: contain;\n      opacity: var(--hero-logo-opacity);\n      mix-blend-mode: screen;\n      filter:\n        drop-shadow(0 0 20px rgba(0, 123, 255, 0.45))\n        drop-shadow(0 0 44px rgba(59, 130, 246, 0.24));\n      transform-style: preserve-3d;\n      animation: heroLogoGyro 12s linear infinite;\n    }\n\n    .hero-ambient-overlay {\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      background:\n        radial-gradient(circle at center, transparent 30%, rgba(248, 250, 252, 0.62) 72%),\n        linear-gradient(to bottom, rgba(248, 250, 252, 0.2), rgba(248, 250, 252, 0.72));\n      z-index: 1;\n    }\n\n    .dark .hero-ambient-overlay {\n      background:\n        radial-gradient(circle at center, transparent 26%, rgba(2, 6, 23, 0.72) 72%),\n        linear-gradient(to bottom, rgba(2, 6, 23, 0.2), rgba(2, 6, 23, 0.82));\n    }\n\n    @keyframes heroStarDrift {\n      from {\n        transform: translate3d(0, 0, 0);\n      }\n      to {\n        transform: translate3d(-26px, 24px, 0);\n      }\n    }\n\n    @keyframes heroGlobeFloat {\n      0%,\n      100% {\n        transform: translateY(0) rotateX(11deg);\n      }\n      50% {\n        transform: translateY(-14px) rotateX(15deg);\n      }\n    }\n\n    @keyframes heroGlobeSpin {\n      from {\n        background-position: center, center, 0% 50%;\n      }\n      to {\n        background-position: center, center, 200% 50%;\n      }\n    }\n\n    @keyframes heroVeilPulse {\n      0%,\n      100% {\n        opacity: 0.78;\n      }\n      50% {\n        opacity: 0.95;\n      }\n    }\n\n    @keyframes heroRingSpinA {\n      from {\n        transform: translate(-50%, -50%) rotateX(72deg) rotateZ(0deg);\n      }\n      to {\n        transform: translate(-50%, -50%) rotateX(72deg) rotateZ(360deg);\n      }\n    }\n\n    @keyframes heroRingSpinB {\n      from {\n        transform: translate(-50%, -50%) rotateY(74deg) rotateX(9deg) rotateZ(0deg);\n      }\n      to {\n        transform: translate(-50%, -50%) rotateY(74deg) rotateX(9deg) rotateZ(360deg);\n      }\n    }\n\n    @keyframes heroLogoOrbit {\n      0%,\n      100% {\n        transform: translate3d(-50%, -50%, 80px) rotateX(0deg);\n      }\n      25% {\n        transform: translate3d(-48%, -51%, 100px) rotateX(6deg);\n      }\n      50% {\n        transform: translate3d(-50%, -49%, 120px) rotateX(-6deg);\n      }\n      75% {\n        transform: translate3d(-52%, -50%, 96px) rotateX(4deg);\n      }\n    }\n\n    @keyframes heroLogoGyro {\n      0% {\n        transform: rotateY(0deg) rotateX(0deg) rotateZ(0deg);\n      }\n      25% {\n        transform: rotateY(95deg) rotateX(13deg) rotateZ(3deg);\n      }\n      50% {\n        transform: rotateY(190deg) rotateX(-10deg) rotateZ(-3deg);\n      }\n      75% {\n        transform: rotateY(280deg) rotateX(8deg) rotateZ(2deg);\n      }\n      100% {\n        transform: rotateY(360deg) rotateX(0deg) rotateZ(0deg);\n      }\n    }\n\n    .footer-ambient-scene {\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      perspective: 1300px;\n      overflow: hidden;\n      z-index: 0;\n      opacity: 0.9;\n    }\n\n    .footer-ambient-orb {\n      position: absolute;\n      left: 50%;\n      top: 50%;\n      border-radius: 9999px;\n      border: 1px solid rgba(0, 123, 255, var(--footer-ring-opacity));\n      filter: drop-shadow(0 0 18px rgba(0, 123, 255, 0.28));\n      transform-origin: center;\n    }\n\n    .footer-ambient-orb--one {\n      width: min(72vw, 720px);\n      aspect-ratio: 1;\n      transform: translate(-50%, -50%) rotateX(70deg);\n      animation: footerRingSpinA 22s linear infinite;\n    }\n\n    .footer-ambient-orb--two {\n      width: min(58vw, 560px);\n      aspect-ratio: 1;\n      transform: translate(-50%, -50%) rotateY(72deg) rotateX(6deg);\n      animation: footerRingSpinB 18s linear infinite reverse;\n    }\n\n    .footer-logo-core {\n      position: absolute;\n      left: 50%;\n      top: 50%;\n      width: min(25vw, 260px);\n      aspect-ratio: 1;\n      transform: translate3d(-50%, -50%, 70px);\n      transform-style: preserve-3d;\n      display: grid;\n      place-items: center;\n      border-radius: 9999px;\n      animation: footerLogoOrbit 12s ease-in-out infinite;\n    }\n\n    .footer-logo-core-img {\n      width: 100%;\n      height: 100%;\n      object-fit: contain;\n      opacity: var(--footer-logo-opacity);\n      mix-blend-mode: screen;\n      filter:\n        drop-shadow(0 0 18px rgba(0, 123, 255, 0.5))\n        drop-shadow(0 0 45px rgba(56, 189, 248, 0.26));\n      transform-style: preserve-3d;\n      animation: footerLogoGyro 14s linear infinite;\n    }\n\n    @keyframes footerRingSpinA {\n      from {\n        transform: translate(-50%, -50%) rotateX(70deg) rotateZ(0deg);\n      }\n      to {\n        transform: translate(-50%, -50%) rotateX(70deg) rotateZ(360deg);\n      }\n    }\n\n    @keyframes footerRingSpinB {\n      from {\n        transform: translate(-50%, -50%) rotateY(72deg) rotateX(6deg) rotateZ(0deg);\n      }\n      to {\n        transform: translate(-50%, -50%) rotateY(72deg) rotateX(6deg) rotateZ(360deg);\n      }\n    }\n\n    @keyframes footerLogoOrbit {\n      0%,\n      100% {\n        transform: translate3d(-50%, -50%, 70px) rotateX(0deg);\n      }\n      50% {\n        transform: translate3d(-50%, -53%, 105px) rotateX(7deg);\n      }\n    }\n\n    @keyframes footerLogoGyro {\n      0% {\n        transform: rotateY(0deg) rotateX(0deg);\n      }\n      25% {\n        transform: rotateY(90deg) rotateX(8deg);\n      }\n      50% {\n        transform: rotateY(180deg) rotateX(-7deg);\n      }\n      75% {\n        transform: rotateY(270deg) rotateX(6deg);\n      }\n      100% {\n        transform: rotateY(360deg) rotateX(0deg);\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .hero-ambient-stars,\n      .hero-globe-shell,\n      .hero-globe-map,\n      .hero-globe-veil,\n      .hero-globe-ring,\n      .hero-logo-core,\n      .hero-logo-core-img,\n      .footer-ambient-orb,\n      .footer-logo-core,\n      .footer-logo-core-img {\n        animation: none !important;\n      }\n    }\n  </style>\n  <link rel=\"stylesheet\" href=\"/index.css\">\n</head>\n\r\n<body>\r\n  <!-- SVG Noise Engine -->\r\n  <svg style=\"position: absolute; width: 0; height: 0; pointer-events: none;\">\r\n    <filter id=\"noiseFilter\">\r\n      <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.65\" numOctaves=\"3\" stitchTiles=\"stitch\" />\r\n      <feColorMatrix t